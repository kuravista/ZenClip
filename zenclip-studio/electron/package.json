{
  "name": "@zenclip/electron",
  "version": "2.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc && electron .",
    "build": "tsc && electron-builder",
    "build:win": "tsc && electron-builder --win",
    "build:mac": "tsc && electron-builder --mac",
    "build:linux": "tsc && electron-builder --linux"
  },
  "dependencies": {
    "electron-log": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^24.0.0",
    "typescript": "^5.3.0"
  },
  "build": {
    "appId": "com.zenclip.studio",
    "productName": "ZenClip",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist",
        "to": "backend",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ]
    },
    "linux": {
      "target": ["AppImage", "deb"]
    }
  }
}
