# ═══════════════════════════════════════════════════════════════════════
# ZenClip Studio — Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════════

# ─── LLM API Keys (set at least one) ─────────────────────────────────
# Used for AI-powered video analysis & clip detection

DEEPSEEK_API_KEY=             # DeepSeek API key (cheapest option)
OPENAI_API_KEY=               # OpenAI API key (Whisper ASR + GPT analysis)
GEMINI_API_KEY=               # Google Gemini API key (gemini-2.5-flash)
ANTHROPIC_API_KEY=            # Anthropic Claude API key
OPENROUTER_API_KEY=           # OpenRouter API key (fallback provider)

# ─── Local LLM (Ollama) ──────────────────────────────────────────────
# Uncomment if running Ollama locally

# LOCAL_LLM_URL=http://localhost:11434/v1
# LOCAL_LLM_API_KEY=ollama
# LOCAL_LLM_MODEL=mistral

# ─── ASR Provider ────────────────────────────────────────────────────
# Options: faster-whisper (default), openai (uses OPENAI_API_KEY)

# CLIP_ASR_PROVIDER=faster-whisper

# ─── Server ──────────────────────────────────────────────────────────

# CLIP_BACKEND_PORT=9478       # Backend port (default: 9478 for app.py, 8011 for modular)
# CLIP_DEBUG=0                 # Enable debug endpoints (0 or 1)
# SNIPIE_DEBUG=0               # Verbose backend logging (0 or 1)

# ─── Paths (optional overrides) ──────────────────────────────────────
# Only set these if you need non-default locations

# CLIP_APP_DATA_DIR=./app-data         # App data root (settings, jobs, cache)
# CLIP_FFMPEG_PATH=                    # FFmpeg binary path (auto-detected if empty)
# CLIP_STATIC_DIR=static               # Static files directory
# CLIP_CLIPS_DIR=                      # Output clips directory
# CLIP_THUMBNAILS_DIR=                 # Thumbnail cache directory
# CLIP_JOBS_DIR=                       # Job metadata directory
# CLIP_FONTS_DIR=                      # Custom fonts directory
# CLIP_CACHE_DIR=                      # Transcript cache directory

# ─── Electron / Sidecar (packaged mode only) ─────────────────────────

# CLIP_SIDECAR_DIR=                    # Sidecar base directory (bundled Python+FFmpeg)
# CLIP_CUDA_DIR=                       # CUDA DLLs directory
# CLIP_DLL_DIR=                        # Additional DLL search path (Windows)

# ─── Runtime ─────────────────────────────────────────────────────────

# PYTHONIOENCODING=utf-8
# PYTHONUNBUFFERED=1
# FORCE_COLOR=1
