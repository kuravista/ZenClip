    "start": 407.8,
    "end": 409.8
  },
  {
    "text": "Kita harus kalahkan ini.",
    "start": 409.8,
    "end": 410.8
  },
  {
    "text": "Kita harus bisa dapet yang gede.",
    "start": 410.8,
    "end": 411.8
  },
  {
    "text": "Kita harus merasa pintem, merasa jago.",
    "start": 411.8,
    "end": 413.8
  },
  {
    "text": "Dan itu satu tahun, dua tahun,",
    "start": 413.8,
